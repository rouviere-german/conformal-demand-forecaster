# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=conformal-demand-forecaster
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Comma-separated lowercase SHA-256 digests of API keys, one list per role.
# Generate a key with: uv run conformal-demand-forecaster generate-api-key
APP_READER_KEY_SHA256=
APP_INGESTOR_KEY_SHA256=
APP_OPERATOR_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

# Runtime artifacts: DuckDB store, registry, calibration, audit log, MLflow file backend.
APP_DATA_DIR=var

# Forecasting and calibration.
APP_FORECAST_HORIZON=28
APP_COVERAGE_LEVELS=0.8,0.95
APP_ACI_GAMMA=0.08
APP_CALIBRATION_WINDOW_DAYS=56
# Largest span (days) the served panel may cover; an ingest that would exceed it is refused.
APP_PANEL_MAX_DAYS=4000

# Coverage monitor: alarm when coverage falls more than the tolerance below nominal.
APP_COVERAGE_WINDOW_DAYS=28
APP_COVERAGE_TOLERANCE=0.02
APP_COVERAGE_SIGNIFICANCE=0.01
APP_COVERAGE_MIN_OBSERVATIONS=30

# Actuals ingest: request size, robust z-score guard, readiness freshness.
APP_INGEST_MAX_RECORDS=1000
APP_GUARD_Z_THRESHOLD=10.0
APP_FRESHNESS_MAX_DAYS=2

# Newsvendor defaults (per unit).
APP_HOLDING_COST=1.0
APP_STOCKOUT_COST=4.0
